<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zamok.UI.EncryptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <FontIcon Glyph="&#xE72E;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="Heading" AutomationProperties.AutomationId="Heading"
                       Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>

        <!-- 1. Пароль -->
        <StackPanel x:Name="PagePassword" Grid.Row="1" Spacing="12">
            <TextBlock x:Uid="Encrypt_PasswordIntro" TextWrapping="Wrap" />
            <PasswordBox x:Name="Password1" AutomationProperties.AutomationId="Password1"
                         x:Uid="Encrypt_Password1" PasswordChanged="OnPasswordChanged" />
            <PasswordBox x:Name="Password2" AutomationProperties.AutomationId="Password2"
                         x:Uid="Encrypt_Password2" PasswordChanged="OnPasswordChanged" />
            <ProgressBar x:Name="StrengthBar" Maximum="4" Height="4" />
            <TextBlock x:Name="StrengthText" AutomationProperties.AutomationId="StrengthText"
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            <CheckBox x:Name="MakeKey" AutomationProperties.AutomationId="MakeKey"
                      x:Uid="Encrypt_MakeKey" IsChecked="True" Margin="0,8,0,0"
                      Checked="OnMakeKeyChanged" Unchecked="OnMakeKeyChanged" />
            <TextBlock x:Name="NoKeyWarning" AutomationProperties.AutomationId="NoKeyWarning"
                       x:Uid="Encrypt_NoKeyWarning" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        </StackPanel>

        <!-- 2. Ключ восстановления -->
        <Grid x:Name="PageKey" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Uid="Encrypt_KeyIntro" TextWrapping="Wrap" />
            <!-- Сетка 11 x 4 из отдельных ячеек: слово никогда не уходит на другую строку от
                 своего номера. Экранный диктор читает весь ключ из имени области. -->
            <ScrollViewer x:Name="KeyWords" Grid.Row="1" AutomationProperties.AutomationId="KeyWords"
                          IsTabStop="True">
                <Grid x:Name="KeyGrid" ColumnSpacing="12" RowSpacing="6" Padding="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveKeyButton" AutomationProperties.AutomationId="SaveKeyButton"
                        x:Uid="Encrypt_SaveKey" Click="OnSaveKeyClick" />
                <Button x:Name="CopyKeyButton" AutomationProperties.AutomationId="CopyKeyButton"
                        x:Uid="Encrypt_CopyKey" Click="OnCopyKeyClick" />
            </StackPanel>
            <TextBlock x:Name="KeySaved" Grid.Row="3" AutomationProperties.AutomationId="KeySaved"
                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
        </Grid>

        <!-- 3. Проверка 4 слов -->
        <StackPanel x:Name="PageVerify" Grid.Row="1" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="Encrypt_VerifyIntro" TextWrapping="Wrap" />
            <TextBox x:Name="Word1" AutomationProperties.AutomationId="Word1" IsSpellCheckEnabled="False" />
            <TextBox x:Name="Word2" AutomationProperties.AutomationId="Word2" IsSpellCheckEnabled="False" />
            <TextBox x:Name="Word3" AutomationProperties.AutomationId="Word3" IsSpellCheckEnabled="False" />
            <TextBox x:Name="Word4" AutomationProperties.AutomationId="Word4" IsSpellCheckEnabled="False" />
        </StackPanel>

        <!-- 4. Прогресс и итог -->
        <StackPanel x:Name="PageProgress" Grid.Row="1" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Name="ProgressTitle" AutomationProperties.AutomationId="ProgressTitle"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="Progress" AutomationProperties.AutomationId="Progress" Maximum="1" />
            <TextBlock x:Name="ProgressText" AutomationProperties.AutomationId="ProgressText"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="12">
            <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="ErrorText"
                       AutomationProperties.LiveSetting="Assertive"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                <Button x:Name="BackButton" AutomationProperties.AutomationId="BackButton"
                        x:Uid="Common_Back" MinWidth="110" Visibility="Collapsed" Click="OnBackClick" />
                <Button x:Name="LockNowButton" AutomationProperties.AutomationId="LockNowButton"
                        x:Uid="Encrypt_LockNow" MinWidth="110" Visibility="Collapsed" Click="OnLockNowClick" />
                <Button x:Name="NextButton" AutomationProperties.AutomationId="NextButton"
                        Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="OnNextClick" />
                <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton"
                        x:Uid="Common_Cancel" MinWidth="110" Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
