<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zamok.UI.IdleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Как системный вопрос: значок и имя папки, текст, полоса с кнопками внизу.
         Главная кнопка «Отложить»: она не теряет несохранённое -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Zamok" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,8,24,16" Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="FolderIcon" Width="40" Height="40" VerticalAlignment="Center" />
                <FontIcon x:Name="FallbackIcon" Glyph="&#xE72E;" FontSize="32" Visibility="Collapsed"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FolderName" AutomationProperties.AutomationId="FolderName"
                               FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FolderPath" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="Message" AutomationProperties.AutomationId="Message" TextWrapping="Wrap" />
            <TextBlock x:Name="OpenIn" AutomationProperties.AutomationId="OpenIn" TextWrapping="Wrap"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="Later" AutomationProperties.AutomationId="Later" x:Uid="Idle_Later" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="ErrorText"
                       AutomationProperties.LiveSetting="Assertive" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="24,16" ColumnSpacing="8"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" Visibility="Collapsed" />
            <Button x:Name="PostponeButton" Grid.Column="1" AutomationProperties.AutomationId="PostponeButton"
                    x:Uid="Idle_Postpone" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Click="OnPostponeClick" />
            <Button x:Name="LockButton" Grid.Column="2" AutomationProperties.AutomationId="LockButton"
                    x:Uid="Idle_LockNow" HorizontalAlignment="Stretch" Click="OnLockClick" />
        </Grid>
    </Grid>
</Window>
