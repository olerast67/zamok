<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zamok.UI.ManageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Сменить пароль или показать ключ восстановления: тот же вид, что у окна пароля -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Zamok" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="FolderIcon" Width="32" Height="32" VerticalAlignment="Center" />
                <FontIcon x:Name="FallbackIcon" Glyph="&#xE72E;" FontSize="24" Visibility="Collapsed"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" AutomationProperties.AutomationId="Heading"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="StepText" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Пароль (старый) и новый пароль -->
            <StackPanel x:Name="PageInput" Grid.Row="1" Spacing="10">
                <TextBlock x:Name="DecryptWarning" x:Uid="Manage_DecryptWarning" TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <PasswordBox x:Name="Password" AutomationProperties.AutomationId="Password"
                             x:Uid="Manage_Password" PasswordRevealMode="Peek" />
                <PasswordBox x:Name="NewPassword1" AutomationProperties.AutomationId="NewPassword1"
                             x:Uid="Manage_NewPassword1" PasswordRevealMode="Peek" PasswordChanged="OnNewChanged" />
                <PasswordBox x:Name="NewPassword2" AutomationProperties.AutomationId="NewPassword2"
                             x:Uid="Manage_NewPassword2" PasswordRevealMode="Peek" PasswordChanged="OnNewChanged" />
                <ProgressBar x:Name="StrengthBar" Maximum="4" Height="3" />
                <TextBlock x:Name="StrengthText" AutomationProperties.AutomationId="StrengthText"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Ключ восстановления -->
            <Grid x:Name="PageKey" Grid.Row="1" RowSpacing="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="6" Padding="12,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="KeyWords" AutomationProperties.AutomationId="KeyWords" IsTabStop="True">
                        <Grid x:Name="KeyGrid" ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="SaveKeyButton" Click="OnSaveKeyClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock x:Uid="Encrypt_SaveKeyText" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.AutomationId="CopyKeyButton" Click="OnCopyKeyClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock x:Uid="Encrypt_CopyKeyText" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="KeySaved" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Ход расшифровки -->
            <StackPanel x:Name="PageProgress" Grid.Row="1" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Uid="Manage_Decrypting" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" AutomationProperties.AutomationId="Progress" Maximum="1" />
                <TextBlock x:Name="ProgressText" AutomationProperties.AutomationId="ProgressText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Итог -->
            <StackPanel x:Name="PageDone" Grid.Row="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="DoneText" AutomationProperties.AutomationId="DoneText"
                           TextWrapping="Wrap" MaxWidth="340" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="2" AutomationProperties.AutomationId="ErrorText"
                       AutomationProperties.LiveSetting="Assertive" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="2" Padding="24,16" ColumnSpacing="8"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" VerticalAlignment="Center" />
            <Button x:Name="OkButton" Grid.Column="2" AutomationProperties.AutomationId="OkButton"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="OnOkClick" />
            <Button x:Name="CancelButton" Grid.Column="3" AutomationProperties.AutomationId="CancelButton"
                    x:Uid="Common_Cancel" MinWidth="96" Click="OnCancelClick" />
        </Grid>
    </Grid>
</Window>
