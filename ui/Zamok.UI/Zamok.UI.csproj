<Project Sdk="Microsoft.NET.Sdk">

  <!-- Zamok.exe: окна пароля и мастера шифрования. WinUI 3 без пакета MSIX, со встроенными
       .NET и Windows App SDK: человеку ничего не нужно ставить отдельно (docs/STACK.md, раздел 3). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Zamok.UI</RootNamespace>
    <AssemblyName>Zamok</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\zamok.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Без этого dotnet publish не кладёт Zamok.pri (строки и разметку окон) и окно падает при запуске -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <!-- Свой Main (Program.cs): язык окон задаётся до запуска WinUI -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LibraryImport создаёт код с unsafe для вызовов Windows -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Значок в заголовке окна; Проводник берёт значок .zamok из самого Zamok.exe -->
    <Content Include="..\..\assets\zamok.ico" Link="zamok.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zamok.Client\Zamok.Client.csproj" />
  </ItemGroup>

</Project>
