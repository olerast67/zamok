<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zamok.UI.TracesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Проверка следов (DESIGN.md, раздел 6): по строке на канал, значок состояния, что сделать -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Zamok" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- На низком экране окно ограничено по высоте, строки прокручиваются -->
        <ScrollViewer Grid.Row="1">
        <StackPanel Padding="24,8,24,16" Spacing="8">
            <TextBlock x:Uid="Traces_Title" AutomationProperties.AutomationId="Heading"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Uid="Traces_Intro" TextWrapping="Wrap" Margin="0,0,0,4" />
            <Border CornerRadius="6" Padding="12,10" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DiskGood" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="DiskWarning" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="DiskUnknown" Glyph="&#xE9CE;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Traces_DiskTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DiskStatus" AutomationProperties.AutomationId="DiskStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="DiskAdvice" AutomationProperties.AutomationId="DiskAdvice" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="6" Padding="12,10" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="HiberGood" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="HiberWarning" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="HiberUnknown" Glyph="&#xE9CE;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Traces_HiberTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="HiberStatus" AutomationProperties.AutomationId="HiberStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="HiberAdvice" AutomationProperties.AutomationId="HiberAdvice" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="6" Padding="12,10" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="PageGood" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="PageWarning" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="PageUnknown" Glyph="&#xE9CE;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Traces_PageTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="PageStatus" AutomationProperties.AutomationId="PageStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="PageAdvice" AutomationProperties.AutomationId="PageAdvice" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="6" Padding="12,10" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="IndexGood" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="IndexWarning" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="IndexUnknown" Glyph="&#xE9CE;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Traces_IndexTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="IndexStatus" AutomationProperties.AutomationId="IndexStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="IndexAdvice" AutomationProperties.AutomationId="IndexAdvice" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="6" Padding="12,10" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="ThumbsGood" Glyph="&#xE930;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="ThumbsWarning" Glyph="&#xE7BA;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <FontIcon x:Name="ThumbsUnknown" Glyph="&#xE9CE;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Uid="Traces_ThumbsTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ThumbsStatus" AutomationProperties.AutomationId="ThumbsStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="ThumbsAdvice" AutomationProperties.AutomationId="ThumbsAdvice" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,16" ColumnSpacing="8"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" Visibility="Collapsed" />
            <Button x:Name="RecheckButton" Grid.Column="2" AutomationProperties.AutomationId="RecheckButton"
                    x:Uid="Traces_Recheck" Click="OnRecheckClick" />
            <Button Grid.Column="3" AutomationProperties.AutomationId="CloseButton" x:Uid="Traces_Close"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
