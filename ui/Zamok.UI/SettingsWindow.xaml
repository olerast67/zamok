<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zamok.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Настройки: зашифрованные папки слева, свойства выбранной справа, общее и «О программе» внизу -->
    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="12,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Uid="Settings_Title" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,16" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Uid="Settings_Folders" FontWeight="SemiBold" />
            <Border Grid.Row="1" CornerRadius="6" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ListView x:Name="FolderList" AutomationProperties.AutomationId="FolderList" MaxHeight="360"
                          SelectionMode="Single" SelectionChanged="OnFolderSelected" />
            </Border>

            <!-- Свойства выбранной папки -->
            <ScrollViewer x:Name="Details" Grid.Column="1" Grid.RowSpan="2" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="FolderIcon" Width="32" Height="32" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" AutomationProperties.AutomationId="DetailName"
                                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailState" AutomationProperties.AutomationId="DetailState"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ToggleButton" AutomationProperties.AutomationId="ToggleButton"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="OnToggleClick" />
                    <Button x:Name="ShowButton" AutomationProperties.AutomationId="ShowButton"
                            x:Uid="Settings_Show" Click="OnShowClick" />
                </StackPanel>

                <StackPanel x:Name="HelloPanel" Visibility="Collapsed" Spacing="2">
                    <ToggleSwitch x:Name="HelloSwitch" AutomationProperties.AutomationId="HelloSwitch"
                                  x:Uid="Settings_Hello" Toggled="OnHelloToggled" />
                    <TextBlock x:Uid="Settings_HelloNote" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ComboBox x:Name="IdleBox" AutomationProperties.AutomationId="IdleBox"
                          x:Uid="Settings_Idle" MinWidth="220" SelectionChanged="OnIdleChanged" />

                <Border CornerRadius="6" Padding="12,10" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Settings_Properties" FontWeight="SemiBold" />
                        <TextBlock x:Name="PropPath" AutomationProperties.AutomationId="PropPath"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="PropVault" AutomationProperties.AutomationId="PropVault"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_Crypto" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="Empty" Grid.Column="1" Grid.RowSpan="2" Spacing="6" Visibility="Collapsed"
                        VerticalAlignment="Center">
                <TextBlock x:Uid="Settings_Empty" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Uid="Settings_EmptyHow" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Padding="24,12" ColumnSpacing="12"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="ErrorText" AutomationProperties.AutomationId="ErrorText" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Visibility="Collapsed"
                           TextWrapping="Wrap" />
                <!-- Предложение исключить скрытые хранилища из проверки Defender: раз на хранилище -->
                <Border x:Name="DefenderCard" AutomationProperties.AutomationId="DefenderCard" Visibility="Collapsed"
                        CornerRadius="6" Padding="12,10" Margin="0,0,0,4" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Defender_Title" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DefenderText" AutomationProperties.AutomationId="DefenderText"
                                   x:Uid="Defender_Text" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="DefenderExclude" AutomationProperties.AutomationId="DefenderExclude"
                                    Style="{StaticResource AccentButtonStyle}" Click="OnDefenderExcludeClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                    <TextBlock x:Uid="Defender_ExcludeText" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DefenderCopy" AutomationProperties.AutomationId="DefenderCopy"
                                    x:Uid="Defender_Copy" Click="OnDefenderCopyClick" />
                            <Button x:Name="DefenderNo" AutomationProperties.AutomationId="DefenderNo"
                                    x:Uid="Defender_No" Click="OnDefenderNoClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ToggleSwitch x:Name="ScreenLockSwitch" AutomationProperties.AutomationId="ScreenLockSwitch"
                              x:Uid="Settings_ScreenLock" Toggled="OnScreenLockToggled" />

            </StackPanel>
            <Button Grid.Column="1" AutomationProperties.AutomationId="CloseButton" x:Uid="Settings_Close"
                    MinWidth="96" VerticalAlignment="Bottom" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
